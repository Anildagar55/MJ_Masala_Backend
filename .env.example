# Copy to .env and fill in. docker compose reads this file.

# --- database ---
DB_NAME=mj_masala
DB_USER=root
DB_PASSWORD=Anil@123
# MySQL only: the container's root password
DB_ROOT_PASSWORD=Anil@123

# --- uploaded product photography ---
# Put this on a mounted volume in production: a container's own filesystem is lost on
# redeploy, and with it every photo the client uploaded.
MEDIA_DIR=./media

# --- one-time code delivery (both off by default: the code is logged instead) ---
# Email over SMTP. Any provider works: SES, Postmark, Gmail, your own relay.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mjmasala.in

# SMS through a provider's HTTP API. provider = msg91 | fast2sms | generic
SMS_ENABLED=false
SMS_PROVIDER=generic
SMS_URL=
SMS_AUTH_KEY=
SMS_SENDER_ID=MJMSLA
# Indian carriers require transactional SMS to go out against a registered DLT template
SMS_TEMPLATE_ID=

# Hand the code back in the API response. ONLY for testing the flow before a provider is
# wired up — it gives the code to whoever asked for it. Set false in any real environment.
OTP_EXPOSE_CODE=true

# --- required in any real environment ---
# Generate with:  openssl rand -base64 48
JWT_SECRET=MjMasalaLocalJwtSecretKey2026Secure
# The first admin account. Seeded once, on an empty database.
ADMIN_EMAIL=admin@mjmasala.in
ADMIN_PASSWORD=replace-me-before-going-live

# --- optional ---
PORT=8080
# comma separated; the Vite dev server and preview server by default
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SPRING_PROFILES_ACTIVE=dev
